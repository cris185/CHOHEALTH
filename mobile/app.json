{
  "expo": {
    "name": "CHOHEALTH Courier",
    "slug": "chohealth-courier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chohealth-courier",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.chohealth.courier",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "CHOHEALTH Courier uses your location to show your position on the map while you're delivering an order.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CHOHEALTH Courier needs your location in the background so patients can see your live position and so nearby deliveries can be offered to you, even while the app isn't in the foreground.",
        "NSCameraUsageDescription": "CHOHEALTH Courier uses your camera to take a photo as proof of delivery.",
        "NSPhotoLibraryUsageDescription": "CHOHEALTH Courier lets you attach a photo from your library as proof of delivery."
      }
    },
    "android": {
      "package": "com.chohealth.courier",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CHOHEALTH Courier needs your location in the background so patients can see your live position and so nearby deliveries can be offered to you, even while the app isn't in the foreground.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "CHOHEALTH Courier uses your camera to take a photo as proof of delivery."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#208AEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43fe638d-41d9-4c54-9efc-3977be195b51"
      }
    },
    "owner": "cris185",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/43fe638d-41d9-4c54-9efc-3977be195b51"
    }
  }
}
